# ── App
NODE_ENV=development
PORT=3000

# ── Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kupot_db
DB_USER=admin
DB_PASSWORD=admin
DB_POOL_MAX=10

# ── Auth
JWT_SECRET=this_is_a_super_secret_key_change_me_please_12345
JWT_EXPIRES_IN=7d

# ── HTTP
CORS_ORIGIN=*
MAX_JSON_BODY=1mb

# ── Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880

# ── Seeding
DEMO_PASSWORD=password123

# ── Geocoding (tasks 58 / 61 / 62)
# We use Google Maps Geocoding API. The API key is NOT stored here — it is
# configured exclusively through the admin SettingsPage UI (stored in the
# `settings` table, key = `google_maps_api_key`). Leaving it empty in the
# database disables geocoding and the verify-location endpoint will respond
# with card_geocoded=false (collectors proceed without the radius check).