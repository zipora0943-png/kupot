# ── App
NODE_ENV=development
PORT=3000

# ── Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kupot_db
DB_USER=admin
DB_PASSWORD=admin
DB_POOL_MAX=10

# ── Auth
JWT_SECRET=this_is_a_super_secret_key_change_me_please_12345
JWT_EXPIRES_IN=7d

# ── HTTP
CORS_ORIGIN=*
MAX_JSON_BODY=1mb

# ── Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880

# ── Seeding
DEMO_PASSWORD=password123

# ── Geocoding (task 58)
# Used by the backend to convert card addresses to coordinates and to power
# the GPS-radius verification before collection in frontend-collector.
# The key stays on the server — clients never see it and never call Google directly.
# Leave empty during development: geocoding will return `disabled` and the
# verify-location endpoint will respond with card_geocoded=false (collectors
# proceed without the radius check).
GOOGLE_MAPS_API_KEY=