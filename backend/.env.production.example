# ── App
NODE_ENV=production
PORT=3000
# Bind only to localhost — nginx (same box) proxies through 127.0.0.1.
# Omitting this falls back to 0.0.0.0 which exposes the backend directly.
BIND_HOST=127.0.0.1

# ── Database (עדכן לפי המסד שעל השרת)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kupot_db
DB_USER=kupot
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_MAX=10

# ── Auth — חובה לייצר ערך אקראי חדש לפרודקשן (ראה הוראות ב-DEPLOY.md)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── HTTP — הפרונטים שמותר להם לפנות לבק
# גם האדמין וגם הקולקטור נטענים מאותו origin (nginx על crm.landwebpage.co.il),
# אז זה ה-origin היחיד שמותר. הקולקטור באפליקציית האנדרואיד רץ על
# capacitor://localhost ולכן לא נשלח Origin (CORS לא רלוונטי שם).
CORS_ORIGIN=https://crm.landwebpage.co.il
MAX_JSON_BODY=1mb

# ── Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880

# ── Seeding
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
