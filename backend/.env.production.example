# ── App
NODE_ENV=production
PORT=3000

# ── Database (עדכן לפי המסד שעל השרת)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kupot_db
DB_USER=kupot
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_POOL_MAX=10

# ── Auth — חובה לייצר ערך אקראי חדש לפרודקשן (ראה הוראות ב-DEPLOY.md)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── HTTP — הפרונטים שמותר להם לפנות לבק
CORS_ORIGIN=http://178.105.96.70:5000,http://178.105.96.70:5001
MAX_JSON_BODY=1mb

# ── Uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880

# ── Seeding
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
